{
  "name": "vspo-cosplay-hub",
  "version": "1.0.0",
  "description": "Vspo! Cosplay Archive - Unified Platform",
  "author": "じゃむじゃ",
  "main": "main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "widget": "electron .",
    "dist": "electron-builder --win",
    "lint": "next lint"
  },
  "build": {
    "appId": "com.vspo.cosplay.widget",
    "productName": "VspoCosplayWidget",
    "copyright": "Copyright © 2026 じゃむじゃ",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "VspoCosplayWidget",
      "runAfterFinish": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "artifactName": "${productName}_Setup_${version}.${ext}"
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "@react-google-maps/api": "^2.20.8",
    "@supabase/supabase-js": "^2.98.0",
    "d3": "^7.9.0",
    "framer-motion": "^12.35.2",
    "leaflet": "^1.9.4",
    "next": "latest",
    "papaparse": "^5.5.3",
    "react": "latest",
    "react-dom": "latest",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  }
}
